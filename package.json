{
  "name": "parkwhere",
  "private": true,
  "version": "0.1.0",
  "description": "Find a carpark near where you're going in Singapore, with available car lots and price estimates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/najibninaba/parkwhere"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "pnpm build && vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "registry": "node scripts/sync-registry.ts",
    "deploy": "pnpm build && wrangler deploy",
    "check:mobile": "node scripts/mobile-check.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "deploy:staging": "pnpm build:staging && wrangler deploy",
    "proof": "node scripts/pr-proof.ts",
    "media": "node scripts/readme-media.ts"
  },
  "dependencies": {
    "effect": "4.0.5",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261018.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1",
    "wrangler": "4.151.1"
  }
}
